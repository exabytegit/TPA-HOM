{
  "name": "tpa-hom",
  "version": "0.1.0",
  "description": "Backend adapter HOMU para Suscripcion Digital Toyota Plan",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "smoke:sandbox": "tsx scripts/smokeSandboxCatalog.ts",
    "smoke:sheet": "tsx scripts/smokeSheetCatalog.ts",
    "catalog:compare-sheet": "tsx scripts/compareCatalogWithSheet.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "toyota-plan",
    "homu",
    "express",
    "typescript"
  ],
  "author": "HOMU S.A.",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.6"
  }
}
